{
  "compilerOptions": {
    "target": "ES2020",
    "module": "node16",
    "lib": ["ES2020"],
    "rootDir": ".",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node16",
    "declaration": true,
    "declarationMap": true,
    "isolatedModules": true,
    "types": ["node", "jest"]
  },
  "include": ["*.ts", "prompts/**/*.ts"],
  "exclude": ["node_modules", "dist", "__tests__"]
}
